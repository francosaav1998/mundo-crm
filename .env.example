# PostgreSQL connection string from Supabase
# IMPORTANTE: en Vercel serverless usá el Connection Pooler (puerto 6543) para no agotar conexiones.
# Ejemplo: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Usar la URL directa (puerto 5432) para la app. El pooler (puerto 6543) no es compatible con migraciones.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
# URL directa obligatoria para Prisma Migrate. Debe apuntar a db.[PROJECT_REF].supabase.co:5432 sin pgbouncer.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Supabase anon key (public, safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"

# Supabase service role key (server only, keep secret)
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Admin email for user management and default lead assignment
# (optional, defaults to admin@mundo-crm.local)
ADMIN_EMAIL="admin@mundo-crm.local"

# Admin password used only by scripts/setup-supabase.js
# Nunca dejes un valor débil en producción.
ADMIN_PASSWORD=""

# Upstash Redis for global rate limiting across Vercel serverless functions
# (optional but strongly recommended for production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# SMTP config for bulk email (optional)
SMTP_HOST=""
SMTP_PORT="587"
# Alternativa para Gmail: SMTP_SERVICE="gmail" (usa contraseña de aplicación)
SMTP_SERVICE=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# OpenAI API key for the AI landing editor chat
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Dominio raiz para subdominios de vendedores (opcional hasta lanzar dominio real)
# Ejemplo: mundofibra.cl
NEXT_PUBLIC_ROOT_DOMAIN=""

# URL publica de la app
# Ejemplo: https://mundo-crm.vercel.app o https://mundofibra.cl
NEXT_PUBLIC_APP_URL=""

# Cloudflare Turnstile para proteger formularios públicos
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# MercadoPago - suscripciones recurrentes
MERCADOPAGO_ACCESS_TOKEN=""

# Token simple para proteger el webhook de MercadoPago.
# Si lo configuras, usa la URL:
# https://tu-dominio.com/api/webhooks/mercadopago?token=ESTE_TOKEN
MERCADOPAGO_WEBHOOK_TOKEN=""
